filters:
  and:
    - file.hasProperty("summary")
views:
  - type: table
    name: Pages
    filters:
      and:
        - type == "page"
    order:
      - file.name
      - category
      - summary
  - type: table
    name: Sources
    filters:
      and:
        - type == "source"
    order:
      - file.name
      - category
      - summary
